# Local Claude Code config — per-clone, not shared.
.claude/

# Junk drawer: superseded files, scratch HTML, pre-refactor JSX shards,
# spare .neonic.png samples. Kept on disk for reference but outside the
# ship surface. Git history retains the tracked ones.
extra/

# macOS Finder metadata.
.DS_Store

# Playwright MCP session artifacts.
.playwright-mcp/

# Local mirror of the article's deploy site (inwordsandpictures.com/neonic).
# Carries copies of neonic-playback.js and logo.neonic.png so the article's
# `../` paths resolve when previewing nwp/neonic/neonic_article.html locally.
nwp/
